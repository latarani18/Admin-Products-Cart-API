{
  "info": {
    "name": "Laravel 11 - Cart & Checkout API",
    "description": "Customer Auth (Sanctum), Cart Module & Checkout APIs for technical assignment"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/register",
          "host": ["http://127.0.0.1:8000"],
          "path": ["api", "register"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/login",
          "host": ["http://127.0.0.1:8000"],
          "path": ["api", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "Cart - Add Item",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/cart/items",
          "host": ["http://127.0.0.1:8000"],
          "path": ["api", "cart", "items"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": 1,\n  \"qty\": 2\n}"
        }
      }
    },
    {
      "name": "Cart - View Cart",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/cart",
          "host": ["http://127.0.0.1:8000"],
          "path": ["api", "cart"]
        }
      }
    },
    {
      "name": "Cart - Update Item Qty",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/cart/items/1",
          "host": ["http://127.0.0.1:8000"],
          "path": ["api", "cart", "items", "1"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"qty\": 5\n}"
        }
      }
    },
    {
      "name": "Cart - Delete Item",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/cart/items/1",
          "host": ["http://127.0.0.1:8000"],
          "path": ["api", "cart", "items", "1"]
        }
      }
    },
    {
      "name": "Checkout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/cart/checkout",
          "host": ["http://127.0.0.1:8000"],
          "path": ["api", "cart", "checkout"]
        }
      }
    },
    {
      "name": "Auth - Logout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/logout",
          "host": ["http://127.0.0.1:8000"],
          "path": ["api", "logout"]
        }
      }
    }
  ]
}
